// ==============================================================
// COFFEE SHOP ORDER MANAGEMENT SYSTEM (AKUFADA)
// Prisma Relational Database Schema (PostgreSQL 16/17)
// Phase 3: Database Architecture, Migrations & Data Integrity
// ==============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------------
// Domain Enums (Mirroring @akufada/shared contracts)
// --------------------------------------------------------------

enum RoleType {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum StockMovementReason {
  ORDER_RESERVATION
  ORDER_CANCELLATION_REFUND
  RESTOCK_PURCHASE
  MANUAL_ADJUSTMENT
  DAMAGED_DISPOSAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  DECLINED
  TIMEOUT
  REFUNDED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// --------------------------------------------------------------
// Identity, Users & Roles
// --------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  phoneNumber  String?  @map("phone_number") @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles           UserRole[]
  refreshTokens   RefreshToken[]
  orders          Order[]
  auditEvents     AuditEvent[]
  stockMovements  StockMovement[]
  idempotencyKeys IdempotencyKey[]
  statusHistories OrderStatusHistory[]

  @@index([isActive], name: "idx_users_is_active")
  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        RoleType   @unique
  description String?    @db.VarChar(255)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash, isRevoked, expiresAt], name: "idx_refresh_tokens_lookup")
  @@map("refresh_tokens")
}

// --------------------------------------------------------------
// Product Catalog & Hierarchy
// --------------------------------------------------------------

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar(100)
  slug         String    @unique @db.VarChar(100)
  description  String?   @db.Text
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  products     Product[]

  @@index([displayOrder, isActive], name: "idx_categories_display")
  @@map("categories")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  name           String    @db.VarChar(150)
  slug           String    @unique @db.VarChar(150)
  description    String?   @db.Text
  basePriceCents Int       @map("base_price_cents") // Exact monetary integer minor units
  imageUrl       String?   @map("image_url") @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory      Inventory?
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([categoryId, isActive], name: "idx_products_category")
  @@map("products")
}

// --------------------------------------------------------------
// Inventory & Immutable Stock Movement Ledger
// --------------------------------------------------------------

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @unique @map("product_id") @db.Uuid
  quantity          Int      @default(0) // Must remain >= 0 via application transactions & database check
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model StockMovement {
  id            String              @id @default(uuid()) @db.Uuid
  productId     String              @map("product_id") @db.Uuid
  userId        String?             @map("user_id") @db.Uuid
  quantityDelta Int                 @map("quantity_delta") // Positive (restock) or negative (reservation)
  balanceAfter  Int                 @map("balance_after")
  reason        StockMovementReason
  notes         String?             @db.VarChar(255)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)], name: "idx_stock_movements_product")
  @@map("stock_movements")
}

// --------------------------------------------------------------
// Orders, Historical Item Pricing & Lifecycle Tracking
// --------------------------------------------------------------

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  orderNumber   String      @unique @map("order_number") @db.VarChar(30)
  userId        String      @map("user_id") @db.Uuid
  status        OrderStatus @default(PENDING)
  subtotalCents Int         @map("subtotal_cents")
  taxCents      Int         @map("tax_cents")
  totalCents    Int         @map("total_cents")
  customerNotes String?     @map("customer_notes") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      PaymentRecord[]

  @@index([userId, createdAt(sort: Desc)], name: "idx_orders_user_created")
  @@index([status, createdAt(sort: Asc)], name: "idx_orders_status_created")
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(150)
  unitPriceCents      Int      @map("unit_price_cents") // Historical price snapshot frozen at checkout
  quantity            Int
  lineTotalCents      Int      @map("line_total_cents")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId], name: "idx_order_items_order")
  @@map("order_items")
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  reason          String?      @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt(sort: Asc)], name: "idx_order_status_history_order")
  @@map("order_status_history")
}

// --------------------------------------------------------------
// Payment Records (Mock Gateway Auditing)
// --------------------------------------------------------------

model PaymentRecord {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  transactionId String        @unique @map("transaction_id") @db.VarChar(100)
  provider      String        @default("MOCK_GATEWAY") @db.VarChar(50)
  amountCents   Int           @map("amount_cents")
  status        PaymentStatus
  failureReason String?       @map("failure_reason") @db.VarChar(255)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId], name: "idx_payment_records_order")
  @@map("payment_records")
}

// --------------------------------------------------------------
// Idempotency Keys (Duplicate Order Submission Prevention)
// --------------------------------------------------------------

model IdempotencyKey {
  key          String            @id @db.VarChar(100) // Client UUID
  userId       String            @map("user_id") @db.Uuid
  requestHash  String            @map("request_hash") @db.VarChar(64)
  status       IdempotencyStatus
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key, userId], name: "idx_idempotency_lookup")
  @@index([expiresAt], name: "idx_idempotency_expiry")
  @@map("idempotency_keys")
}

// --------------------------------------------------------------
// Immutable Administrative Audit Events
// --------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityName String   @map("entity_name") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId], name: "idx_audit_events_entity")
  @@index([createdAt(sort: Desc)], name: "idx_audit_events_created")
  @@map("audit_events")
}
