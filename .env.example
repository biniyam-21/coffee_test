# ==============================================================
# COFFEE SHOP ORDER MANAGEMENT SYSTEM (AKUFADA)
# Environment Variables Template - Local Development
# ==============================================================

# Core System
NODE_ENV=development
PORT=3001
INSTANCE_ID=api-node-1

# Gateway & Ports
GATEWAY_PORT=80
HOST_LAN_IP=192.168.1.150

# Database Configuration (PostgreSQL 16) - Deferred to Phase 3
POSTGRES_DB=akufada_db
POSTGRES_USER=akufada_admin
POSTGRES_PASSWORD=ChangeMeInLocalEnv_AdminPassword123!
POSTGRES_APP_USER=akufada_app
POSTGRES_APP_PASSWORD=ChangeMeInLocalEnv_AppPassword123!
# Docker Compose API containers use the postgres service DNS name. For a backend process on the host, use 127.0.0.1 instead.
DATABASE_URL=postgresql://akufada_app:ChangeMeInLocalEnv_AppPassword123!@postgres:5432/akufada_db?schema=public

# Cryptography & JWT Security - Deferred to Phase 4
JWT_ACCESS_SECRET=dummy_local_development_jwt_access_secret_key_at_least_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dummy_local_development_jwt_refresh_secret_key_at_least_32_chars_long
JWT_REFRESH_EXPIRATION_DAYS=7

# External Mock Payment Service
MOCK_PAYMENT_URL=http://localhost:4000
MOCK_PAYMENT_PORT=4000
MOCK_PAYMENT_API_KEY=dummy_mock_secret_key_akufada_test

# Client Configuration
VITE_API_BASE_URL=/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.150:80/api/v1

# Chapa test integration: server requests use the secret key; never put it in web/mobile envs.
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_API_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=https://your-public-host.example/api/v1/payments/chapa/callback

CHAPA_EXPECTED_MODE=test
CHAPA_TIMEOUT_MS=10000
CHAPA_RECONCILE_INTERVAL_MS=300000


CHAPA_RETURN_URL=http://localhost:3000/payment/return
